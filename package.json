    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "author": "Matthew Firth <hello@modelbrain.net> (https://modelbrain.net)",
  "homepage": "https://modelbrain.net",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "modelbrain",
    "memory",
    "ai-memory",
    "local-first"
  ],
  "os": [
    "darwin",
    "win32",
    "linux"
  ],
